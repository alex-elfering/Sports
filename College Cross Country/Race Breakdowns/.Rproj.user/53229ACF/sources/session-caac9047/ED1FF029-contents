    filter(as.numeric(distance_m) == max(as.numeric(distance_m)))
  
  label_text <- glue("{test_school}\nstayed\nin this\nrange")
  
  median_color <- school_color_var_light
  
}else if (options_select == 'Nearest Neighbor'){
  
  athlete_final_place <- clean_xc_data |>
    filter(distance_m == max(distance_m)) |>
    filter(athlete == test_athlete) |>
    pull(place)
  
  athlete_min_place <- athlete_final_place - 1
  athlete_max_place <- athlete_final_place + 1
  
  neighbors <- clean_xc_data |>
    filter(distance_m == max(distance_m)) |>
    filter(place == athlete_min_place | place == athlete_max_place) |>
    pull(athlete)
  
  pacing_split <- clean_xc_data |>
    mutate(distance_m = factor(distance_m)) |>
    filter(athlete %in% neighbors) |>
    group_by(distance_m) |>
    summarise(
      slowest_pace = min(pace_km_min, na.rm = TRUE),
      fastest_pace = max(pace_km_min, na.rm = TRUE),
      .groups = 'drop'
    ) 
  
  pacing_final_split <- pacing_split |>
    filter(distance_m == 10000)
  
}


