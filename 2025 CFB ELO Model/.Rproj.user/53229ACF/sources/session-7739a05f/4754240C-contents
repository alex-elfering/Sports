library(dplyr)
library(readxl)
library(tibble)
library(purrr)

# Load and prepare
game_df <- readxl::read_excel('C:/Users/alexe/OneDrive/Desktop/movies to watch.xlsx')
game_df <- game_df %>%
  mutate(Score = (runif(n(), 1, 100)) ) |>
  sample_n(30)

candidates  <- game_df$Movies

# Number of simulated villagers (voters)
num_voters <- 10100

prob_weights <- game_df$Score / sum(game_df$Score)

generate_weighted_ballot <- function(candidates, weights) {
  sample(candidates, length(candidates), replace = FALSE, prob = weights)
}

ballots <- replicate(num_voters, generate_weighted_ballot(game_df$Movies, prob_weights), simplify = FALSE)

# === Step 3: Ranked Choice Voting with Redistribution Tracking ===
ranked_choice_voting <- function(ballots, candidates) {
  round <- 1
  remaining <- candidates
  all_rounds <- list()
  
  while (length(remaining) > 1) {
    cat(sprintf("\n--- Round %d ---\n", round))
    
    current_votes <- sapply(ballots, function(b) b[which(b %in% remaining)[1]])
    vote_counts <- table(factor(current_votes, levels = remaining))
    total_votes <- sum(vote_counts)
    
    # Build a results data frame for this round
    round_df <- tibble(
      Round = round,
      Movie = names(vote_counts),
      Votes = as.integer(vote_counts),
      Percent = round(100 * as.integer(vote_counts) / total_votes, 3)
    )
    
    # Print results to console
    round_df %>%
      arrange(desc(Votes)) %>%
      mutate(Display = sprintf("%s: %d votes (%.2f%%)", Movie, Votes, Percent)) %>%
      pull(Display) %>%
      cat(sep = "\n")
    
    # Add to cumulative results list
    all_rounds[[round]] <- round_df
    
    top <- round_df$Movie[which.max(round_df$Votes)]
    if (round_df$Votes[round_df$Movie == top] > total_votes / 2) {
      cat(sprintf("\n🏆 %s wins with %d votes (%.2f%% majority)!\n", 
                  top, round_df$Votes[round_df$Movie == top],
                  round_df$Percent[round_df$Movie == top]))
      break
    }
    
    # Eliminate lowest
    min_votes <- min(vote_counts)
    eliminated <- names(vote_counts)[vote_counts == min_votes]
    if (length(eliminated) > 1) {
      eliminated <- sample(eliminated, 1)
      cat(sprintf("🤝 Tie for fewest votes! Randomly eliminating %s...\n", eliminated))
    } else {
      cat(sprintf("💀 Eliminating %s...\n", eliminated))
    }
    
    to_redistribute <- which(current_votes == eliminated)
    n <- length(to_redistribute)
    cat(sprintf("🔁 Redistributing %d ballots from %s:\n", n, eliminated))
    
    dest_votes <- sapply(to_redistribute, function(i) {
      ballots[[i]][which(ballots[[i]] %in% setdiff(remaining, eliminated))[1]]
    })
    dest_counts <- table(factor(dest_votes, levels = setdiff(remaining, eliminated)))
    
    for (dest in names(dest_counts)) {
      cat(sprintf("   • +%d to %s\n", dest_counts[dest], dest))
    }
    
    remaining <- setdiff(remaining, eliminated)
    round <- round + 1
  }
  
  winner <- if (length(remaining) == 1) remaining else top
  
  cat(sprintf("\n🎬 Final Winner: %s\n", winner))
  
  # Combine all rounds into a single data frame
  results_df <- bind_rows(all_rounds)
  return(list(winner = winner, results = results_df))
}

# === Step 4: Run the simulation ===
winner <- ranked_choice_voting(ballots, candidates)
#cat("\n🎬 Best Picture According to Voters:", winner, "\n")

repeat {
  ballots <- replicate(num_voters, generate_weighted_ballot(game_df$Movies, prob_weights), simplify = FALSE)
  result <- ranked_choice_voting(ballots, candidates)
  
  # Grab the last round of voting
  final_round <- result$results %>%
    filter(Round == max(Round)) %>%
    arrange(desc(Votes))
  
  top_percent <- final_round$Percent[1]
  
  if (top_percent >= 60) {
    cat(sprintf("\n✅ Victory secured with %.2f%% of the final vote!\n", top_percent))
    break
  } else {
    cat(sprintf("\n🔁 Winner only received %.2f%%... restarting simulation.\n", top_percent))
  }
}