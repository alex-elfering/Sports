print(michigan_quality_losses)

# Find Michigan's worst/most damaging losses
michigan_bad_losses <- get_team_bad_losses(quality_losses, "Nebraska", 2025)
print(michigan_bad_losses)

# Analyze how losses aged
michigan_loss_aging <- get_loss_aging_analysis(quality_losses, "Nebraska", 2025)
print("Losses that aged well:")
print(michigan_loss_aging$aged_well)
print("Losses that aged poorly:")
print(michigan_loss_aging$aged_poorly)

# Compare playoff contenders' loss quality
contenders <- c("Georgia", "Ohio State", "Michigan", "Alabama")
loss_comparison <- compare_loss_quality(quality_losses, contenders, 2024)
print(loss_comparison)

# Find all "good losses" in 2024
good_losses_2024 <- identify_good_losses(quality_losses, 2025, min_opp_elo = 2100)
print(good_losses_2024)

# Visualize
plot_loss_quality_timeline(quality_losses, "Ohio State", 2002)

# Complete résumé (wins + losses)
quality_wins <- calculate_quality_wins(full_elo_df, weekly_rankings)
ohio_state_resume <- get_complete_resume(quality_wins, quality_losses, 
                                         "Nebraska", 2025)
print(ohio_state_resume)

