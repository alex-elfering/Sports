library(gt)
library(tidyverse)
library(glue)

# Create ELO Rankings Table Function ----
create_elo_rankings_table <- function(weekly_rankings, weekly_season_wlt, 
                                      season_var, week_var, n_teams = 136) {
  #' Generate formatted GT table of ELO rankings
  #' 
  #' @param weekly_rankings ELO rankings data
  #' @param weekly_season_wlt Win-loss-tie records
  #' @param season_var Season year
  #' @param week_var Week number
  #' @param n_teams Number of teams to show (default 25)
  #' @return GT table object
  
  # Constants ----
  ARROWS <- list(
    up = "<span style=\"color:#4292c6\">&#9650;</span>",
    down = "<span style=\"color:#ef6548\">&#9660;</span>",
    neutral = "<span style=\"color:#fed976\">&#9644;</span>"
  )
  
  COLORS <- list(
    gray_text = "gray75",
    border = "#334422",
    body_border = "#0000001A"
  )
  
  # Prepare Data ----
  rank_data <- get_top_25(weekly_rankings, season_var, week_var) |>
    as.data.frame() |>
    inner_join(weekly_season_wlt, by = c("team", "season", "wk")) |>
    select(rank_change, rank, team, conf, total_record, elo, elo_change,
           last_result, next_week_info) |>
    mutate(elo = round(elo, 1),
           elo_change = round(elo_change,1)) |>
    head(n_teams)
  
  # Helper Functions ----
  format_rank_change <- function(x) {
    case_when(
      x > 0 ~ paste0("+", x),
      TRUE ~ as.character(x)
    )
  }
  
  # Build Table ----
  rank_data |>
    gt() |>
    # Header ----
  tab_header(
    title = md("**College Football Rankings**"),
    subtitle = glue("{season_var} Season as of Week #{week_var}")
  ) |>
    # Source Notes ----
  tab_source_note(
    source_note = paste(
      "ELO ratings score each team based on factors such as home-field advantage,",
      "margin of victory, and quality of opponent. At the end of each season,",
      "school ratings regress partially to the value of their respective conference.",
      "Teams new to FBS begin with an ELO rating of 1500."
    )
  ) |>
    tab_source_note(
      source_note = "Code by Alex Elfering | Source: College Football Reference | Model Inspired by FiveThirtyEight"
    ) |>
    # Styling: Gray text for conference and bye weeks ----
  tab_style(
    style = cell_text(color = COLORS$gray_text),
    locations = list(
      cells_body(columns = conf),
      cells_body(columns = last_result, rows = last_result == "Bye Week"),
      cells_body(columns = next_week_info, rows = next_week_info == "vs. Bye Week")
    )
  ) |>
    # Styling: Bold team and rank ----
  tab_style(
    style = cell_text(weight = "bold"),
    locations = cells_body(columns = c(team, rank))
  ) |>
    # Table Options ----
  tab_options(
    column_labels.border.top.style = "none",
    table.border.top.style = "none",
    column_labels.border.bottom.style = "none",
    column_labels.border.bottom.width = px(1),
    column_labels.border.bottom.color = COLORS$border,
    table_body.border.top.style = "none",
    table_body.border.bottom.color = COLORS$body_border,
    data_row.padding = px(7),
    table.font.names = "Noto Sans JP",
    table.font.size = px(12)
  ) |>
    # Column Labels ----
  tab_style(
    style = cell_text(size = px(12), weight = "bold", transform = "uppercase"),
    locations = cells_column_labels(everything())
  ) |>
    # Body Text Size ----
  tab_style(
    style = cell_text(size = px(12)),
    locations = cells_body(everything())
  ) |>
    # Rank Change Arrows ----
  text_transform(
    locations = cells_body(columns = rank_change, rows = rank_change > 0),
    fn = function(x) paste(x, ARROWS$up)
  ) |>
    text_transform(
      locations = cells_body(columns = rank_change, rows = rank_change < 0),
      fn = function(x) paste(x, ARROWS$down)
    ) |>
    text_transform(
      locations = cells_body(columns = rank_change, rows = rank_change == 0),
      fn = function(x) paste(x, ARROWS$neutral)
    ) |>
    # Format Rank Change with + sign ----
  fmt(
    columns = rank_change,
    rows = rank_change > 0,
    fns = function(x) paste0("+", x)
  ) |>
    # Column Labels (Optional: Rename) ----
  cols_label(
    rank_change = "CHG",
    rank = "RNK",
    team = "TEAM",
    conf = "CONF",
    total_record = "RECORD",
    elo = "ELO",
    last_result = "LAST RESULT",
    next_week_info = "NEXT OPPONENT"
  )
}

# Usage ----
elo_table <- create_elo_rankings_table(
  weekly_rankings = weekly_rankings,
  weekly_season_wlt = weekly_season_wlt,
  season_var = 2025,
  week_var =10
)

elo_table

# Save if needed
gtsave(elo_table, "elo_rankings_2000_week9.html")