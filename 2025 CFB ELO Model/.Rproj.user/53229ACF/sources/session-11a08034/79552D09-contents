school_dates_wk_list <- list()
counter <- 0
for(i in c(1869:1870, c(1872:2025))){
  
  tryCatch({
    message(glue("Fetching: {i}"))
    
    counter <- counter + 1
    if(counter%%14 == 0){Sys.sleep(60)}
    
    #i <- 2025

    dates_url <- glue('https://www.sports-reference.com/cfb/years/{i}-schedule.html')
    
    schedules <- read_html(dates_url)
    schedule_season <- schedules |> html_table(fill = TRUE) |> as.data.frame() |> clean_names()
    
    school_season_unique <- schedule_season |>
      mutate(season = i) |>
      select(season,
             wk,
             date,
             winner,
             loser,
             contains('var_'),
             pts = pts,
             opp = pts_1) |>
      mutate(winner = trim(stri_trim_both(str_remove_all(winner, paste(rank_patterns, collapse = "|")))),
             loser = trim(stri_trim_both(str_remove_all(loser, paste(rank_patterns, collapse = "|"))))) |>
      filter(wk != 'Wk')
    print(school_season_unique)
    
    school_dates_wk_list[[i]] <- school_season_unique
    print(school_season_unique)
    
  }, error=function(e){})
  
  
}

