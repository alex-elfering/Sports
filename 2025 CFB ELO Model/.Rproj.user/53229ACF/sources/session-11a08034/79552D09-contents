    schedules <- read_html(dates_url)
    schedule_season <- schedules |> html_table(fill = TRUE) |> as.data.frame() |> row_to_names(row_number = 1) |> clean_names()
    
    school_season_unique <- schedule_season |>
      #row_to_names(row_number = 1) |>
      mutate(season = i) |>
      separate(conf, into = c("conference", "division"), sep = " \\(", fill = "right") |>
      mutate(
