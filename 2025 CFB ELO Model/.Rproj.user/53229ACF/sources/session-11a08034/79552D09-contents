# college football schedule & conference scrapping

library(tidyverse)  # already includes dplyr, readr, ggplot2, etc.
library(data.table) # needed for rbindlist
library(janitor)    # used for clean_names
library(rvest)      # HTML scraping
library(glue)       # used for data clarity while scrapping
library(stringr)    # used for data cleaning post-scrapping
library(stringi)

rank_patterns <- paste('\\(', 1:25, '\\)', sep = '')
trim <- function (x) gsub("^\\s+|\\s+$", "", x)
clean_url_name <- function(x) {
  x %>%
    str_to_lower() %>%
    str_replace_all(" ", "-") %>%
    str_remove_all("'") %>%
    str_replace_all("\\-&-", "-") %>%
    str_remove_all("&") %>%
    str_remove_all("[()]")
}

