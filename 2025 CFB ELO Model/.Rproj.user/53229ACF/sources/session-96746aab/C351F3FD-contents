# Example 4: Visualize projection changes
library(ggplot2)

projection_evolution <- map_dfr(weeks_to_track, ~{
  timeline_1999[[paste0("week_", .x)]]$projections |>
    select(team, current_wins, mean_final_wins, prob_10plus) |>
    mutate(as_of_week = .x)
})

# Plot top teams' win projections over time
top_teams <- projection_evolution |>
  filter(as_of_week == max(as_of_week)) |>
  slice_max(mean_final_wins, n = 10) |>
  pull(team)

projection_evolution |>
  filter(team %in% top_teams) |>
  ggplot(aes(x = as_of_week, y = mean_final_wins, color = team, group = team)) +
  geom_line(size = 1) +
  geom_point(size = 2) +
  labs(
    title = "1999 Season - Win Projections Over Time",
    subtitle = "How expectations changed as season progressed",
    x = "Projection Made After Week",
    y = "Projected Final Wins",
    color = "Team"
  ) +
  theme_minimal() +
  theme(legend.position = "right")