  weekly_rankings = weekly_rankings,
  full_elo_df = full_elo_df,
  conf_df = conf_df,
  season_num = 2025,
  as_of_week = 7,
  future_schedule = schedule_2025,
  conference_games_only = FALSE,  # Include ALL remaining games
  n_sims = 10000
)

