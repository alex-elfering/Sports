rank_patterns <- paste('\\(', 1:25, '\\)', sep = '')
trim <- function (x) gsub("^\\s+|\\s+$", "", x)
clean_url_name <- function(x) {
x %>%
str_to_lower() %>%
str_replace_all(" ", "-") %>%
str_remove_all("'") %>%
str_replace_all("\\-&-", "-") %>%
str_remove_all("&") %>%
str_remove_all("[()]")
}
name_map <- c(
"UTEP" = "Texas-El Paso",
"UAB" = "Alabama-Birmingham",
"BYU" = "Brigham Young",
"UCF" = "Central Florida",
"LSU" = "Louisiana State",
"Ole Miss" = "Mississippi",
"Pitt" = "Pittsburgh",
"USC" = "Southern California",
"SMU" = "Southern Methodist",
"UTSA" = "Texas-San Antonio",
