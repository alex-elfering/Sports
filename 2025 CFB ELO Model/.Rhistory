if(counter%%14 == 0){Sys.sleep(60)}
#print(counter)
#print(seasons_dates)
schedules <- read_html(i)
schedule_season <- schedules |> html_table(fill = TRUE)
list_length <- length(schedule_season)
if(list_length == 1){
seasons_dates <- schedule_season[1] |>
as.data.frame() |>
mutate(Season = season_filter$seasons) |>
distinct() |>
filter(Date != 'Date')
}else if(list_length == 2){
seasons_dates <- schedule_season[2] |>
as.data.frame() |>
mutate(Season = season_filter$seasons) |>
distinct() |>
filter(Date != 'Date')
}
print(seasons_dates)
school_seasons_schedule_list[[i]] <- seasons_dates
}, error=function(e){})
}
rbindlist(school_seasons_schedule_list, fill = T) |> clean_names() |> write.csv('C:/Users/alexe/OneDrive/Documents/Sports Analysis/full college football notes.csv')
