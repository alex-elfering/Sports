for(i in schools_list$school_url){
tryCatch({
message(glue("Fetching: {i}"))
season_filter <- dplyr::filter(schools_list, school_url == i)
#seasons_url <- glue('https://www.sports-reference.com/cfb/years/{i}-schedule.html')
